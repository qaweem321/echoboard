# Copy this file to .env and fill in real values. Never commit .env.
# The app checks these when it starts and lists anything missing or invalid.

# Postgres connection string from the Neon dashboard (Connect -> Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Random string used to sign session cookies (32+ characters)
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# The URL your app runs at, without a trailing slash
BETTER_AUTH_URL="http://localhost:3000"

# Resend API key for sending real emails. Optional in development (emails are printed in the
# terminal instead), required in production.
RESEND_API_KEY=""
# Optional: sender address (must be a domain verified in Resend)
EMAIL_FROM="Echoboard <onboarding@resend.dev>"

# Optional: "true" for a public demo without emails (no verification, invite links shown on
# screen, a banner explains it). Never on for a real app.
DEMO_MODE=""

# Billing provider: "polar" or "stripe". Pick one before launch.
BILLING_PROVIDER="polar"

# Polar (https://polar.sh) - use sandbox.polar.sh for testing
POLAR_SERVER="sandbox"
POLAR_ACCESS_TOKEN=""
POLAR_PRO_PRODUCT_ID=""
# Required in production (Polar dashboard > Settings > Webhooks)
POLAR_WEBHOOK_SECRET=""

# Stripe (https://stripe.com) - use test mode keys (sk_test_...) while developing
# 1. Create a recurring monthly price for your Pro product and copy its price ID (price_...)
# 2. Activate the customer portal once: Settings > Billing > Customer portal > Save
# 3. Add a webhook endpoint for /api/webhooks/stripe with the customer.subscription.* and
#    checkout.session.completed events, and copy its signing secret (whsec_...)
STRIPE_SECRET_KEY=""
STRIPE_PRO_PRICE_ID=""
# Required in production
STRIPE_WEBHOOK_SECRET=""
# Optional: free trial length in days for new Stripe subscriptions
STRIPE_TRIAL_DAYS=""
